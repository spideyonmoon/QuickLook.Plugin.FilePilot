<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net462</TargetFramework>
        <RootNamespace>QuickLook.Plugin.FilePilot</RootNamespace>
        <AssemblyName>QuickLook.Plugin.FilePilot</AssemblyName>
        <Platforms>AnyCPU</Platforms>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>full</DebugType>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>

    <!-- QuickLook already ships QuickLook.Common.dll; don't bundle a second copy. -->
    <Target Name="ReduceReleasePackaging" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <Delete Files="$(OutputPath)QuickLook.Common.dll;$(OutputPath)QuickLook.Common.pdb" />
    </Target>

    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="Properties\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="QuickLook.Plugin.Metadata.config" Condition="Exists('QuickLook.Plugin.Metadata.config')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="QuickLook.Common\QuickLook.Common.csproj">
            <Project>{85FDD6BA-871D-46C8-BD64-F6BB0CB5EA95}</Project>
            <Name>QuickLook.Common</Name>
            <Private>False</Private>
        </ProjectReference>
    </ItemGroup>
</Project>
